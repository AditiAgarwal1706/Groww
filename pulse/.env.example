# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://pulse_user:pulse_pass@localhost:5432/pulse_db

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT Auth ───────────────────────────────────────────────
JWT_SECRET=change_this_to_a_very_long_random_secret_key_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ─── Market Data ────────────────────────────────────────────
# Primary: yfinance (no key needed)
# Fallback: Alpha Vantage (free: 25 req/day at alphavantage.co)
ALPHA_VANTAGE_API_KEY=

# ─── News API ───────────────────────────────────────────────
# Get free key at newsapi.org (100 req/day dev tier)
NEWS_API_KEY=

# ─── AI ─────────────────────────────────────────────────────
# Get free key at aistudio.google.com (Gemini free tier)
GEMINI_API_KEY=

# ─── App Config ─────────────────────────────────────────────
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── Worker Config ──────────────────────────────────────────
MARKET_POLL_INTERVAL_SECONDS=300
NEWS_POLL_INTERVAL_SECONDS=900
